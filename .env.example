# Copy to .env for Docker Compose. Replace with `openssl rand -hex 32` output.
# Multiple tokens: token-a,token-b (no whitespace inside a token).
# The native `test` client also loads the current directory's .env automatically.
# For a client-only file, use SPEEDPROBE_SERVER and SPEEDPROBE_TOKEN below.
# The native `serve` command does not auto-load .env.
SPEEDPROBE_TOKENS=replace-with-a-long-random-token
SPEEDPROBE_BIND_IP=127.0.0.1
SPEEDPROBE_PORT=8080
SPEEDPROBE_VERSION=dev
SPEEDPROBE_MAX_CONCURRENT=32
SPEEDPROBE_MAX_PER_TOKEN=8
# Per request, per direction, not a monthly quota. Unit: bytes.
SPEEDPROBE_MAX_BYTES=1073741824
SPEEDPROBE_MAX_DURATION=60s
# Aggregate payload bytes/sec across all tokens and both directions; 0 disables.
SPEEDPROBE_BYTES_PER_SECOND=0

# Optional settings for the native client (Compose ignores these).
# SPEEDPROBE_SERVER=https://speed.example.com
# SPEEDPROBE_TOKEN=your-client-token
# SPEEDPROBE_CONNECTIONS=4
# SPEEDPROBE_DURATION=10s
# SPEEDPROBE_TIMEOUT=5s
# SPEEDPROBE_LATENCY_SAMPLES=20
# SPEEDPROBE_LATENCY_INTERVAL=50ms
# SPEEDPROBE_IP=auto
# SPEEDPROBE_JSON=false
# SPEEDPROBE_INTERVAL=5m
# SPEEDPROBE_COUNT=0
# SPEEDPROBE_LOG_FILE=logs/speedprobe.jsonl
